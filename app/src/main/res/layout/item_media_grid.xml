<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/g_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_thumb_placeholder"
        android:contentDescription="@string/cd_thumbnail"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Thumb" />

    <LinearLayout
        android:id="@+id/g_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="@id/g_thumb"
        app:layout_constraintEnd_toEndOf="@id/g_thumb"
        app:layout_constraintStart_toStartOf="@id/g_thumb">

        <TextView
            android:id="@+id/g_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/badge_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/g_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/badge_text"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/g_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_play_overlay"
        app:layout_constraintBottom_toBottomOf="@id/g_thumb"
        app:layout_constraintEnd_toEndOf="@id/g_thumb"
        app:layout_constraintStart_toStartOf="@id/g_thumb"
        app:layout_constraintTop_toTopOf="@id/g_thumb" />

    <TextView
        android:id="@+id/g_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/badge_text"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/g_thumb"
        app:layout_constraintTop_toTopOf="@id/g_thumb" />

    <TextView
        android:id="@+id/g_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/badge_text"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/g_thumb"
        app:layout_constraintTop_toTopOf="@id/g_thumb" />

    <TextView
        android:id="@+id/g_missing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/scrim_dark"
        android:gravity="center"
        android:text="@string/missing"
        android:textColor="@color/badge_text"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/g_thumb"
        app:layout_constraintEnd_toEndOf="@id/g_thumb"
        app:layout_constraintStart_toStartOf="@id/g_thumb"
        app:layout_constraintTop_toTopOf="@id/g_thumb" />

    <View
        android:id="@+id/g_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_selected_frame"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/g_thumb"
        app:layout_constraintEnd_toEndOf="@id/g_thumb"
        app:layout_constraintStart_toStartOf="@id/g_thumb"
        app:layout_constraintTop_toTopOf="@id/g_thumb" />

    <ImageView
        android:id="@+id/g_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_overlay"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/g_thumb"
        app:layout_constraintTop_toTopOf="@id/g_thumb" />
</androidx.constraintlayout.widget.ConstraintLayout>
