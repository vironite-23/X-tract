<?xml version="1.0" encoding="utf-8"?>
<!-- Title row of the Downloads tab (title + Library/Queue toggle). Shared by the library and queue screens.
     When placed inside an AppBarLayout it scrolls out of view and comes back when scrolling up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/downloads_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    app:layout_scrollFlags="scroll|enterAlways|snap">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/nav_downloads"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/downloads_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggle_library"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggle_queue"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/queue" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
